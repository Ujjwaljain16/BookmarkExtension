{
  "manifest_version": 3,
  "name": "Fuze Web Clipper",
  "short_name": "Fuze Clipper",
  "version": "1.1.2",
  "description": "Save and organize web content with Fuze - your intelligent bookmark manager",
  "minimum_chrome_version": "116",
  "permissions": [
    "bookmarks",
    "storage",
    "activeTab",
    "scripting",
    "notifications",
    "contextMenus",
    "alarms"
  ],
  "host_permissions": [
    "https://ujjwaljain16-fuze-backend.hf.space/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://itsfuze.vercel.app/*"],
      "js": ["lib/config.js", "content/fuze-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
